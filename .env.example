# Choose provider: gemini | openai | heuristic
AI_PROVIDER=gemini

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini model
GEMINI_MODEL=gemini-2.0-flash

# Security / ops
# Comma-separated browser origins allowed for CORS (defaults to localhost:8000/5500)
CORS_ALLOW_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set to 0 in production to disable /docs and /redoc
ENABLE_API_DOCS=1
